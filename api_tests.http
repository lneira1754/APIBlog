@adminToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..nYDN6_7OFsCUzzzfLMoJA5wnkLG0xMCUuhb9YMhUJ1k
@postId = 12
@commentId = 1
@categoryId = 1
@userId = 8

### AUTH - Registro (201)
POST {{baseUrl}}/register
Content-Type: application/json

{
  "username": "nuevo_user1",
  "email": "nuevo1_user@example.com",
  "password": "ClaveSegura123"
}

### AUTH - Registro con email duplicado (400)
POST {{baseUrl}}/register
Content-Type: application/json

{
  "username": "nuevo_user",
  "email": "nuevo_user@example.com",
  "password": "ClaveSegura123"
}

### AUTH - Login (200)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "nuevo_user@example.com",
  "password": "ClaveSegura123"
}

### AUTH - Login con password incorrecto (401)
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "nuevo_user@example.com",
  "password": "Incorrecta"
}

### AUTH - Perfil (200)
GET {{baseUrl}}/profile
Authorization: Bearer {{userToken}}

### AUTH - Perfil sin token (401)
GET {{baseUrl}}/profile

### POSTS - Listado público (200)
GET {{baseUrl}}/posts

### POSTS - Crear post (201)
POST {{baseUrl}}/posts
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "title": "Primer post",
  "content": "Contenido del post",
  "is_published": true,
  "categories": [{{categoryId}}]
}

### POSTS - Crear post sin token (401)
POST {{baseUrl}}/posts
Content-Type: application/json

{
  "title": "Debe fallar",
  "content": "sin token"
}

### POSTS - Obtener detalle (200)
GET {{baseUrl}}/posts/{{postId}}

### POSTS - Detalle inexistente (404)
GET {{baseUrl}}/posts/999999

### POSTS - Actualizar post (200)
PUT {{baseUrl}}/posts/{{postId}}
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "title": "Post editado"
}

### POSTS - Actualizar sin permisos (403)
PUT {{baseUrl}}/posts/{{postId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "No deberia poder si no es duenio"
}

### POSTS - Eliminar post (200)
DELETE {{baseUrl}}/posts/{{postId}}
Authorization: Bearer {{userToken}}

### POSTS - Eliminar sin autenticación (401)
DELETE {{baseUrl}}/posts/{{postId}}

### POSTS - Mis posts (200)
GET {{baseUrl}}/my-posts
Authorization: Bearer {{userToken}}

### POSTS - Mis posts sin token (401)
GET {{baseUrl}}/my-posts

### COMMENTS - Listar por post (200)
GET {{baseUrl}}/posts/{{postId}}/comments

### COMMENTS - Crear comentario (201)
POST {{baseUrl}}/posts/{{postId}}/comments
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "content": "Buen artículo" 
}

### COMMENTS - Crear sin contenido (400)
POST {{baseUrl}}/posts/{{postId}}/comments
Authorization: Bearer {{userToken}}
Content-Type: application/json

{}

### COMMENTS - Eliminar comentario (200)
DELETE {{baseUrl}}/comments/{{commentId}}
Authorization: Bearer {{userToken}}

### COMMENTS - Eliminar sin permisos (403)
DELETE {{baseUrl}}/comments/{{commentId}}
Authorization: Bearer {{adminToken}}

